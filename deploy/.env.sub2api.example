TZ=Asia/Shanghai

# Use your real domain, for example: sub.example.com
SUB2API_DOMAIN=sub.example.com

# Admin account created on first startup.
SUB2API_ADMIN_EMAIL=admin@example.com
SUB2API_ADMIN_PASSWORD=change_this_admin_password

# Generate with: openssl rand -hex 32
SUB2API_DB_PASSWORD=change_this_database_password
REDIS_PASSWORD=change_this_redis_password
JWT_SECRET=change_this_jwt_secret
TOTP_ENCRYPTION_KEY=change_this_totp_encryption_key

# Conservative defaults for a 2C/4C server. Increase only after monitoring.
DATABASE_MAX_OPEN_CONNS=50
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME_MINUTES=30
DATABASE_CONN_MAX_IDLE_TIME_MINUTES=5
REDIS_POOL_SIZE=256
REDIS_MIN_IDLE_CONNS=10
